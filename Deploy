AWSTemplateFormatVersion: '2010-09-09'
Description: 'Infraestrutura como Código: Provisionamento automatizado de Servidor Web com Security Group integrado.'

Parameters:
  InstanceTypeParameter:
    Type: String
    Default: t2.micro
    AllowedValues: [t2.micro, t3.micro]
    Description: Escolha o tipo de instância (t2.micro ou t3.micro) para o Servidor Web.

Mappings:
  RegionMap:
    us-east-1:
      AMI: ami-0c7217cdde317cfec
    us-west-2:
      AMI: ami-008fe2ecd65c7c003

Resources:
  WebServerSecurityGroup:
    Type: 'AWS::EC2::SecurityGroup'
    Properties:
      GroupDescription: Habilita acesso HTTP na porta 80 e SSH na porta 22
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 80
          ToPort: 80
          CidrIp: 0.0.0.0/0
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: 0.0.0.0/0

  WebServerInstance:
    Type: 'AWS::EC2::Instance'
    Properties:
      InstanceType: !Ref InstanceTypeParameter
      ImageId: !FindInMap [RegionMap, !Ref 'AWS::Region', AMI]
      SecurityGroups:
        - !Ref WebServerSecurityGroup
      UserData:
        Fn::Base64: !Sub |
          #!/bin/bash
          yum update -y
          yum install -y httpd
          systemctl start httpd
          systemctl enable httpd
          echo "<h1>Servidor Web Ativo - Infraestrutura como Código via CloudFormation!</h1>" > /var/www/html/index.html

Outputs:
  WebsiteURL:
    Description: URL Pública do Servidor Web publicado
    Value: !Sub 'http://${WebServerInstance.PublicDnsName}'
